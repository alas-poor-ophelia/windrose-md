{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declarationDir": "./.tsbuild-unused",
    "types": [],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": "..",
    "paths": {
      "#types": ["./types/index.ts"],
      "#types/*": ["./types/*.ts"]
    },
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts", "**/*.mjs"],
  "exclude": ["**/dist/**", "**/out/**"]
}
